content_margin_bottom = 3.0
bg_color = Color(0.16, 0.2, 0.36, 0.95)
border_width_left = 1
border_width_top = 1
border_width_right = 1
border_width_bottom = 1
border_color = Color(1, 0.85, 0.5, 1)
corner_radius_top_left = 3
corner_radius_top_right = 3
